<!DOCTYPE html>
<html><head><meta charset="utf-8"><title><%= $title %></title></head>
<body style="margin:0;padding:0;background:#f2f4f7;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#202124;">
