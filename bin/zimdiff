        <div style="color:#3c4043;margin-top:2px;<%= $del %>"><%= $e->{start} %><% if ($e->{end}) { %> &ndash; <%= $e->{end} %><% } %></div>
%     if ($e->{loc}) {
        <div style="color:#5f6368;margin-top:2px;<%= $del %>">&#x1F4CD; <%= $e->{loc} %></div>
%     }
%     if ($c->{type} eq 'changed' && %{$c->{diff}}) {
        <table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:6px;font-size:13px;border-collapse:collapse;">
%       for my $f (grep { $c->{diff}{$_} } @$fields) {
          <tr>
            <td style="padding:2px 10px 2px 0;color:#5f6368;"><%= $t->($f) %></td>
            <td style="padding:2px 6px 2px 0;color:#c5221f;text-decoration:line-through;"><%= $c->{old}{$f} || '–' %></td>
            <td style="padding:2px 6px 2px 0;color:#5f6368;">&rarr;</td>
            <td style="padding:2px 0;color:#1e7e34;font-weight:600;"><%= $e->{$f} || '–' %></td>
          </tr>
%       }
        </table>
%     } elsif ($c->{type} eq 'changed') {
        <div style="font-size:13px;color:#5f6368;margin-top:4px;"><%= $t->('details') %></div>
%     }
      </td>
    </tr>
%   }
  </table>
% }
</td></tr>
% }
<tr><td style="padding:16px 24px;border-top:1px solid #dadce0;font-size:12px;color:#80868b;"><%= $t->('generated', $main::VERSION) %></td></tr>
</table>
</td></tr></table>
</body></html>
EOT

sub html_report ($report, $cfg) {
    my $title = $cfg->{mail}{subject} // t('title');
    my $out = Mojo::Template->new(auto_escape => 1)->render($HTML_TEMPLATE,
        $report, counts($report), \@FIELDS, $title);
    die "HTML template: $out" if ref $out;
    return "$out";
}

sub mime_header ($str) {
    return $str if $str =~ /^[\x20-\x7e]*$/;
    return '=?UTF-8?B?' . encode_base64(encode_utf8($str), '') . '?=';
}

sub send_mail ($mail, $subject, $text, $html) {
    my @to   = ref $mail->{to} ? @{$mail->{to}} : ($mail->{to});
    # mail.from is "addr" or "Display Name <addr>"
    my $from_cfg = $mail->{from} // ($ENV{USER} // 'zimdiff') . '@localhost';
    my ($name, $from) = $from_cfg =~ /^\s*"?(.*?)"?\s*<([^>]+)>\s*$/
        ? ($1, $2) : ('', $from_cfg);
    my $from_hdr = length $name
        ? ($name =~ /^[\x20-\x7e]*$/ ? '"' . ($name =~ s/(["\\])/\\$1/gr) . '"'
                                      : mime_header($name)) . " <$from>"
        : $from;
    my $b    = 'zimdiff-' . time . "-$$";
    # %a and %b follow LC_TIME, the Date header needs the English names
    my @lt   = localtime;
    my $date = sprintf '%s, %02d %s %04d %s',
        (qw(Sun Mon Tue Wed Thu Fri Sat))[$lt[6]], $lt[3],
        (qw(Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec))[$lt[4]],
        $lt[5] + 1900, strftime('%H:%M:%S %z', @lt);
    my $msg  = join "\r\n",
        "From: $from_hdr",
        'To: ' . join(', ', @to),
        'Subject: ' . mime_header($subject),
        "Date: $date",
        'MIME-Version: 1.0',
        "Content-Type: multipart/alternative; boundary=\"$b\"",
        '',
        "--$b",
        'Content-Type: text/plain; charset=UTF-8',
        'Content-Transfer-Encoding: base64',
        '',
        encode_base64(encode_utf8($text)),
        "--$b",
        'Content-Type: text/html; charset=UTF-8',
        'Content-Transfer-Encoding: base64',
        '',
        encode_base64(encode_utf8($html)),
        "--$b--",
        '';

    if (my $smtp = $mail->{smtp}) {
        require Net::SMTP;
        my $s = Net::SMTP->new($smtp->{host},
            Port => $smtp->{port} // ($smtp->{ssl} ? 465 : 25),
            SSL  => $smtp->{ssl} ? 1 : 0,
            Timeout => 30,
        ) or die "SMTP connect to $smtp->{host} failed: $@\n";
        if ($smtp->{starttls}) {
            $s->starttls or die "SMTP STARTTLS failed: " . $s->message;
        }
        if ($smtp->{user}) {
            $s->auth($smtp->{user}, $smtp->{password})
                or die "SMTP auth failed: " . $s->message;
        }
        $s->mail($from)    or die "SMTP MAIL FROM failed: " . $s->message;
        $s->to(@to)        or die "SMTP RCPT TO failed: " . $s->message;
        $s->data($msg)     or die "SMTP DATA failed: " . $s->message;
        $s->quit;
    }
    else {
        my $sendmail = $mail->{sendmail} // '/usr/sbin/sendmail';
        open my $fh, '|-', $sendmail, '-t', '-oi', '-f', $from
            or die "Cannot run $sendmail: $!\n";
        print $fh $msg =~ s/\r\n/\n/gr;
        close $fh or die "$sendmail failed (exit " . ($? >> 8) . ")\n";
    }
}

main;

__END__

=head1 NAME

zimdiff - report changes in Zimbra calendars by mail

=head1 SYNOPSIS

B<zimdiff> [I<options>...] [I<calendar>...]

 -c, --config=FILE   config file (default: etc/zimdiff.conf)
 -n, --no-action     do not update the cache and do not send mail
 -M, --no-mail       do not send mail
     --html=FILE     also write the HTML report to FILE
 -v, --verbose       report whether mail was sent
     --version       print version and exit
 -h, --help          display this help and exit
     --man           show man-page and exit

=head1 DESCRIPTION

Shows what has changed in the given calendars (for example
C<alice@example.com/Calendar>) since the last invocation. Without arguments the
calendars listed in the config file are checked.

The report is printed to stdout. If C<mail.to> is set in the config file
and there are changes (or C<mail.always> is true), it is also sent as an
HTML mail with a plain text alternative.

The config is read from F<etc/zimdiff.conf> and the calendar state is
kept in F<var/>. In the source tree both are relative to the tree; after
B<make install> they are under the configured I<sysconfdir> and
I<localstatedir>F</zimdiff>.

The first run for a calendar only stores its state and reports the
number of appointments.

zimdiff reads the calendars through CalDAV, logged in as C<zimbra.user>.
The calendars of other accounts must be shared with that account.

An account with two factor authentication needs an application passcode as
C<zimbra.password>. It is created in the Zimbra web client under
Preferences, Accounts, Two-step authentication, Applications, Add
Application Code. Zimbra shows the passcode only once, and accepts it for
CalDAV but not for its web client, SOAP or REST interfaces.

=head1 CONFIGURATION

F<etc/zimdiff.conf> is a JSON file, see F<etc/zimdiff.conf.dist>.

  zimbra.url       server, for example https://zimbra.example.com
  zimbra.user      account used to log in, for example you@example.com; it
                   must be able to read the calendars, for example
                   because they are shared with it
  zimbra.password  its password, or an application passcode
  calendars        calendars checked when none are given on the
                   command line, as "owner/Folder" strings or as
                   objects { "path": "owner/Folder", "name": "Label" }
  timezone         time zone for the report, for example Europe/Zurich
  language         language of the report: en (default) or de
  cache_dir        state directory (default: var)
  mail.to          recipient or list of recipients
  mail.from        sender, "addr" or "Display Name <addr>"
  mail.subject     subject prefix
  mail.always      also send mail when nothing changed
  mail.sendmail    sendmail binary (default: /usr/sbin/sendmail)
  mail.smtp        use SMTP instead: host, port, ssl, starttls,
                   user, password

=head1 EXIT STATUS

0 on success, 2 if a calendar could not be fetched.

