% } else {
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:10px;border-collapse:collapse;font-size:14px;">
%   for my $c (@{$r->{changes}}) {
%     my $e = $c->{entry};
%     my $del = $c->{type} eq 'deleted' ? 'text-decoration:line-through;color:#80868b;' : '';
    <tr>
      <td valign="top" style="padding:10px 10px 10px 0;border-top:1px solid #eceff1;width:84px;">
