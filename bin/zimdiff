#!/usr/bin/env perl

use FindBin;
use lib "$FindBin::RealBin/../thirdparty/lib/perl5"; # LIBDIR
use Mojo::Base -strict, -signatures;
use Mojo::UserAgent;
use Mojo::URL;
use Mojo::File qw(path);
use Mojo::JSON qw(decode_json);
use Mojo::Template;
use Mojo::Util qw(url_escape);
use POSIX qw(strftime);
use Storable qw(retrieve nstore);
use Time::Local qw(timegm);
use MIME::Base64 qw(encode_base64);
use Encode qw(encode_utf8);
use Getopt::Long 2.25 qw(:config posix_default no_ignore_case);
use Pod::Usage 1.14;

our $VERSION = '2.1.0'; # VERSION

my $ROOT = path($FindBin::RealBin)->dirname;

# fields that are shown and compared, in display order
my @FIELDS = qw(start end recur name loc org);

# texts of the report, selected by the 'language' config key
my %I18N = (
    en => {
        start => 'Start', end => 'End', recur => 'Recurring', name => 'Title',
        loc => 'Location', org => 'Organizer',
        new => 'NEW', changed => 'CHANGED', deleted => 'DELETED',
        n_new => '%d new', n_changed => '%d changed', n_deleted => '%d deleted',
        n_error => '%d errors',
        title => 'Calendar changes', no_changes => 'No changes',
        error => 'Error', first_run_1 => 'First run: %d appointment stored.',
        first_run_n => 'First run: %d appointments stored.',
        details => 'Details (description, attendees, ...) changed',
        generated => 'Generated by zimdiff %s', all_day => 'all day',
        untitled => '(no title)', yes => 'yes', series => 'Recurring appointment',
        wday => [qw(Sun Mon Tue Wed Thu Fri Sat)], date => '%Y-%m-%d',
    },
    de => {
        start => 'Beginn', end => 'Ende', recur => 'Serie', name => 'Titel',
        loc => 'Ort', org => 'Organisator',
        new => 'NEU', changed => 'GEÄNDERT', deleted => 'GELÖSCHT',
        n_new => '%d neu', n_changed => '%d geändert', n_deleted => '%d gelöscht',
        n_error => '%d Fehler',
        title => 'Kalender-Änderungen', no_changes => 'Keine Änderungen',
        error => 'Fehler', first_run_1 => 'Erster Lauf: %d Termin gespeichert.',
        first_run_n => 'Erster Lauf: %d Termine gespeichert.',
        details => 'Details (Beschreibung, Teilnehmer, ...) geändert',
        generated => 'Erzeugt von zimdiff %s', all_day => 'ganztägig',
        untitled => '(ohne Titel)', yes => 'ja', series => 'Serientermin',
        wday => [qw(So Mo Di Mi Do Fr Sa)], date => '%d.%m.%Y',
    },
);
our $LANG = $I18N{en};

sub t ($key, @args) {
    my $text = $LANG->{$key} // $key;
    return @args ? sprintf($text, @args) : $text;
}

my %opt = (config => "$ROOT/etc/zimdiff.conf"); # CONFFILE

binmode STDOUT, ':encoding(UTF-8)';
binmode STDERR, ':encoding(UTF-8)';

sub main {
    GetOptions(\%opt, 'help|h', 'man', 'version', 'noaction|no-action|n',
        'nomail|no-mail|M', 'html=s', 'config|c=s', 'verbose|v')
        or exit 1;
    pod2usage(1) if $opt{help};
    pod2usage(-exitstatus => 0, -verbose => 2) if $opt{man};
    if ($opt{version}) { say "zimdiff $VERSION"; exit 0 }

    my $cfg = load_config($opt{config});
    my $lang = $cfg->{language} // 'en';
    $LANG = $I18N{$lang} or die "Unknown language '$lang' (en, de)\n";
    $ENV{TZ} = $cfg->{timezone} if $cfg->{timezone};
    POSIX::tzset();

    my $var = path($cfg->{cache_dir} // "$ROOT/var"); # VARDIR
    $var = $ROOT->child($var) unless $var->is_abs;
    $var->make_path;

    my @cals = map { ref $_ ? $_ : { path => $_ } }
        @ARGV ? @ARGV : @{$cfg->{calendars} // []};
    @cals = ({ path => "$cfg->{zimbra}{user}/Calendar" }) unless @cals;

    my $ua = Mojo::UserAgent->new(
        connect_timeout => 20, request_timeout => 120);

    my @report = map { check_calendar($ua, $cfg, $var, $_) } @cals;

    my $changes = 0;
    $changes += $_->{error} ? 1 : scalar @{$_->{changes}} for @report;

    print text_report(\@report);

    # the mail only lists calendars with something to report
    my @mailrep = grep { $_->{error} or $_->{initialized} or @{$_->{changes}} }
        @report;
    my $html = html_report(\@mailrep, $cfg);
    write_file($opt{html}, encode_utf8($html)) if $opt{html};

    my $mail = $cfg->{mail} // {};
    my $to = ref $mail->{to} ? $mail->{to} : [ $mail->{to} // () ];
    if ($opt{nomail} or $opt{noaction} or not @$to) {
        say "(no mail sent)" if $opt{verbose};
    }
    elsif ($changes or $mail->{always}) {
        # without the mail the changes would be lost: the next run would
        # compare against the new state, so keep the old one
        eval { send_mail($mail, subject(\@report, $mail),
            text_report(\@mailrep), $html); 1 } or do {
            print STDERR "Sending mail failed, calendar state not updated: $@";
            exit 1;
        };
        say "Mail sent to " . join(', ', @$to)
            if $opt{verbose};
    }

    unless ($opt{noaction}) {
        save_state($_->{save}[0], $_->{save}[1]) for grep { $_->{save} } @report;
    }
    exit(grep({ $_->{error} } @report) ? 2 : 0);
}

sub write_file ($file, $bytes, $mode = undef) {
    my $tmp = "$file.tmp";
    open my $fh, '>:raw', $tmp or die "Cannot write $tmp: $!\n";
    chmod $mode, $tmp if defined $mode;
    print $fh $bytes or die "Cannot write $tmp: $!\n";
    close $fh or die "Cannot write $tmp: $!\n";
    rename $tmp, $file or die "Cannot rename $tmp: $!\n";
}

sub save_state ($store, $data) {
    my $tmp = "$store.tmp";
    nstore($data, $tmp);
    rename $tmp, "$store" or die "Cannot rename $tmp: $!\n";
}

sub load_config ($file) {
    die "Config file $file not found (see etc/zimdiff.conf.dist)\n"
        unless -r $file;
    my $mode = (stat $file)[2] & 07777;
    warn "WARNING: $file is readable by others (chmod 600 recommended)\n"
        if $mode & 0044;
    my $cfg = eval { decode_json(path($file)->slurp) }
        or die "Cannot parse $file: $@";
    for my $key (qw(url user password)) {
        die "Missing zimbra.$key in $file\n" unless $cfg->{zimbra}{$key};
    }
    return $cfg;
}

sub base_url ($cfg) {
    my $url = Mojo::URL->new($cfg->{zimbra}{url});
    return $url->path('/')->query('')->fragment(undef);
}

sub ical_utc ($ms) {
    return strftime('%Y%m%dT%H%M%SZ', gmtime int($ms / 1000));
}

# Read the events of one calendar through CalDAV. Zimbra accepts application
# passcodes for CalDAV, but not for its SOAP and REST interfaces.
sub fetch ($ua, $cfg, $cal, $start, $end = undef) {
    my $z   = $cfg->{zimbra};
    my $url = base_url($cfg);
    $url->userinfo("$z->{user}:$z->{password}");
    push @{$url->path->parts}, 'dav', (split m{/}, $cal), '';
    my $range = 'start="' . ical_utc($start) . '"'
        . (defined $end ? ' end="' . ical_utc($end) . '"' : '');
    my $query = <<"EOQ";
<?xml version="1.0" encoding="utf-8"?>
<C:calendar-query xmlns:D="DAV:" xmlns:C="urn:ietf:params:xml:ns:caldav">
  <D:prop><D:getetag/><C:calendar-data/></D:prop>
  <C:filter><C:comp-filter name="VCALENDAR"><C:comp-filter name="VEVENT">
    <C:time-range $range/>
  </C:comp-filter></C:comp-filter></C:filter>
</C:calendar-query>
EOQ
    my $tx = $ua->start($ua->build_tx(REPORT => $url => {
        Depth => 1, 'Content-Type' => 'application/xml; charset=utf-8',
    } => $query));
    my $res = $tx->res;
    if (my $err = $tx->error) {
        die(($err->{code} ? "HTTP $err->{code} " : '') . "$err->{message}\n");
    }
    die "Unexpected answer from Zimbra (HTTP " . $res->code . ")\n"
        unless $res->code == 207;
    my @entries;
    for my $r ($res->dom->find('response')->each) {
        my $data = $r->at('calendar-data') or next;
        my $etag = $r->at('getetag');
        my $entry = entry(parse_ics($data->text), $etag ? $etag->text : '')
            or next;
        push @entries, $entry;
    }
    return \@entries;
}

# The events of one calendar object as a list of { NAME => { value, PARAM } }.
sub parse_ics ($text) {
    $text =~ s/\r?\n[ \t]//g;    # unfold continuation lines
    my (@events, $ev, $depth);
    for my $line (split /\r?\n/, $text) {
        if ($line =~ /^BEGIN:(\w+)/) {
            if ($1 eq 'VEVENT' and not $ev) { $ev = {}; $depth = 0; next }
            $depth++ if $ev;
            next;
        }
        if ($line =~ /^END:(\w+)/) {
            if ($ev and $1 eq 'VEVENT' and !$depth) { push @events, $ev; undef $ev; next }
            $depth-- if $ev;
            next;
        }
        next unless $ev and !$depth;    # skip VALARM and the like
        my ($name, $params, $value) =
            $line =~ /^([A-Za-z0-9-]+)((?:;[^:;=]+=(?:"[^"]*"|[^:;"]*))*):(.*)$/
            or next;
        my %p = (value => $value);
        while ($params =~ /;([^=]+)=("[^"]*"|[^;]*)/g) {
            my ($k, $v) = (uc $1, $2);
            $v =~ s/^"(.*)"$/$1/;
            $p{$k} = $v;
        }
        $ev->{uc $name} //= \%p;
    }
    return \@events;
}

sub ics_text ($prop) {
    return undef unless $prop;
    my $v = $prop->{value};
    $v =~ s/\\n/\n/gi;
    $v =~ s/\\([,;\\])/$1/g;
    return $v;
}

# DTSTART / DTEND as { u => epoch ms } or, for dates, { d => YYYYMMDD }
sub ics_time ($prop) {
    return undef unless $prop;
    my $v = $prop->{value};
    return { d => $1 } if $v =~ /^(\d{8})$/;
    my ($Y, $M, $D, $h, $m, $s, $z) =
        $v =~ /^(\d{4})(\d\d)(\d\d)T(\d\d)(\d\d)(\d\d)(Z?)$/ or return undef;
    my @tm = ($s, $m, $h, $D, $M - 1, $Y - 1900);
    return { u => timegm(@tm) * 1000 } if $z;
    my $tzid = $prop->{TZID} // '';
    my $saved = $ENV{TZ};
    $ENV{TZ} = $tzid if $tzid =~ m{^[A-Za-z_]+(?:/[A-Za-z0-9_+-]+)*$}
        and -e "/usr/share/zoneinfo/$tzid";
    POSIX::tzset();
    my $epoch = POSIX::mktime(@tm, 0, 0, -1);
    if (defined $saved) { $ENV{TZ} = $saved } else { delete $ENV{TZ} }
    POSIX::tzset();
    return { u => $epoch * 1000 };
}

sub check_calendar ($ua, $cfg, $var, $c) {
    my $cal   = $c->{path};
    my $res   = { calendar => $c->{name} // $cal, changes => [] };
    my $store = $var->child(url_escape($cal, '^A-Za-z0-9\-_.') . '.store');
    my $now   = time * 1000;

    my $old = eval { -r $store ? retrieve("$store") : undef };
    if (my $err = $@) {
        chomp $err;
        $res->{error} = "Cannot read state $store: $err";
        return $res;
    }
    # state of zimdiff 2.0.x came from the REST interface, with other ids;
    # start over instead of reporting every appointment as deleted and new
    $old = undef if $old and grep { ($_->{v} // 0) < 3 } values %$old;
    my $mtime = $old ? (stat $store)[9] * 1000 : undef;

    my ($current, $past) = eval {
        my $cur  = fetch($ua, $cfg, $cal, $now);
        # appointments that moved into the past since the last run are
        # not deletions, so fetch them as well for the comparison
        my $past = $mtime ? fetch($ua, $cfg, $cal, $mtime, $now) : [];
        ($cur, $past);
    };
    if (my $err = $@) {
        chomp $err;
        $res->{error} = $err;
        return $res;
    }

    my $new = { map { $_->{id} => $_ } @$current };
    $res->{count} = scalar keys %$new;

    $res->{save} = [ $store, $new ];

    unless ($old) {
        $res->{initialized} = 1;
        return $res;
    }

    my $cmp = { %$new, map { $_->{id} => $_ } @$past };
    my @ch;
    for my $id (keys %$cmp) {
        my ($n, $o) = ($cmp->{$id}, $old->{$id});
        if (not $o) {
            push @ch, { type => 'new', entry => view($n) };
        }
        elsif ($o->{rev} ne $n->{rev}) {
            # both sides are formatted now, in the same language
            my ($nv, $ov) = (view($n), view($o));
            my @diff = grep { ($ov->{$_} // '') ne ($nv->{$_} // '') }
                @FIELDS;
            push @ch, { type => 'changed', entry => $nv, old => $ov,
                diff => { map { $_ => 1 } @diff } };
        }
    }
    for my $id (keys %$old) {
        next if $cmp->{$id};
        # an appointment that is over drops out of the query without being
        # deleted; it showed up as deleted when it ended after the last run
        my $end = end_ms($old->{$id});
        next if defined $end and $end <= $now;
        push @ch, { type => 'deleted', entry => view($old->{$id}) };
    }
    $res->{changes} = [ sort {
        $a->{entry}{sort} cmp $b->{entry}{sort}
            or $a->{entry}{name} cmp $b->{entry}{name}
    } @ch ];
    return $res;
}

# The state keeps raw values; view() formats them for the report, so a change
# of the report language does not show up as a changed field.
sub entry ($events, $etag) {
    # a series with exceptions holds one VEVENT per exception; the master
    # has no RECURRENCE-ID
    my ($ev) = grep({ !$_->{'RECURRENCE-ID'} } @$events);
    $ev //= $events->[0] or return undef;
    my $uid = $ev->{UID} ? $ev->{UID}{value} : return undef;
    my ($s, $e) = (ics_time($ev->{DTSTART}), ics_time($ev->{DTEND}));
    my $allday = $s && $s->{d} ? 1 : 0;
    if ($allday and $e and $e->{d}) {
        # the end date of an all-day event is exclusive
        my ($Y, $M, $D) = $e->{d} =~ /^(\d{4})(\d\d)(\d\d)$/;
        my $last = strftime('%Y%m%d', 0, 0, 12, $D - 1, $M - 1, $Y - 1900);
        $e = $last gt $s->{d} ? { d => $last } : undef;
    }
    my $org = $ev->{ORGANIZER};
    return {
        v      => 3,
        id     => $uid,
        rev    => $etag,
        s      => $s,
        e      => $e,
        allday => $allday,
        recur  => $ev->{RRULE} ? 1 : 0,
        name   => ics_text($ev->{SUMMARY}),
        loc    => ics_text($ev->{LOCATION}) // '',
        org    => $org ? ($org->{CN} // ($org->{value} =~ s/^mailto://ir)) : '',
    };
}

sub view ($x) {
    my ($start, $end) = (tmfmt($x->{s}) // '?', tmfmt($x->{e}) // '');
    if ($x->{allday}) {
        $end = '' if $end eq $start;
        $end .= ' (' . t('all_day') . ')' if $end;
        $start .= ' (' . t('all_day') . ')' unless $end;
    }
    return {
        sort  => sortkey($x->{s}),
        start => $start,
        end   => $end,
        recur => $x->{recur} ? t('yes') : '',
        name  => $x->{name} // t('untitled'),
        loc   => $x->{loc},
        org   => $x->{org},
    };
}

# end of an appointment in ms; an all-day end date counts to the end of the day
sub end_ms ($x) {
    my $t = $x->{e} // $x->{s} // return undef;
    return $t->{u} if $t->{u};
    my $ms = 0 + sortkey($t) or return undef;
    return ($t->{d} // '') =~ /^\d{8}$/ ? $ms + 86_400_000 : $ms;
}

sub sortkey ($t) {
    return '' unless $t;
    my $ms = $t->{u};
    if (!$ms and ($t->{d} // '') =~ /^(\d{4})(\d\d)(\d\d)(?:T(\d\d)(\d\d))?/) {
        $ms = POSIX::mktime(0, $5 // 0, $4 // 0, $3, $2 - 1, $1 - 1900) * 1000;
    }
    return sprintf '%015d', $ms // 0;
}

sub tmfmt ($t) {
    return undef unless $t;
    if ($t->{u}) {
        my @lt = localtime $t->{u} / 1000;
        return t('wday')->[$lt[6]] . strftime(' ' . t('date') . ' %H:%M', @lt);
    }
    my $d = $t->{d} // return undef;
    if ($d =~ /^(\d{4})(\d\d)(\d\d)(?:T(\d\d)(\d\d))?/) {
        my $date = strftime(t('date'), 0, 0, 12, $3, $2 - 1, $1 - 1900);
        return defined $4 ? "$date $4:$5" : $date;
    }
    return $d;
}

sub text_report ($report) {
    return "\n" . t('no_changes') . "\n\n" unless @$report;
    my $out = '';
    for my $r (@$report) {
        $out .= "\n" . uc($r->{calendar}) . "\n" . ('-' x 60) . "\n";
        if ($r->{error}) { $out .= uc(t('error')) . ": $r->{error}\n"; next }
        if ($r->{initialized}) {
            $out .= first_run($r->{count}) . "\n"; next;
        }
        $out .= t('no_changes') . "\n" unless @{$r->{changes}};
        for my $c (@{$r->{changes}}) {
            my $e = $c->{entry};
            $out .= sprintf "%-9s %s  %s%s\n", t($c->{type}),
                $e->{start} . ($e->{end} ? " - $e->{end}" : ''), $e->{name},
                $e->{loc} ? " [$e->{loc}]" : '';
            next unless $c->{type} eq 'changed';
            for my $f (grep { $c->{diff}{$_} } @FIELDS) {
                $out .= sprintf "          %s: %s -> %s\n", t($f),
                    $c->{old}{$f} || '-', $e->{$f} || '-';
            }
        }
    }
    return "$out\n";
}

sub first_run ($count) {
    return t($count == 1 ? 'first_run_1' : 'first_run_n', $count);
}

sub counts ($report) {
    my %n = (new => 0, changed => 0, deleted => 0, error => 0);
    for my $r (@$report) {
        $n{error}++ if $r->{error};
        $n{$_->{type}}++ for @{$r->{changes}};
    }
    return \%n;
}

sub subject ($report, $mail) {
    my $n = counts($report);
    my @p = map { t("n_$_", $n->{$_}) }
        grep { $n->{$_} } qw(new changed deleted error);
    my $prefix = $mail->{subject} // t('title');
    return $prefix . ': ' . (@p ? join(', ', @p) : lc t('no_changes'));
}

