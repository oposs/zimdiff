#!/usr/bin/env perl

use FindBin;
use lib "$FindBin::RealBin/../thirdparty/lib/perl5"; # LIBDIR
use Mojo::Base -strict, -signatures;
use Mojo::UserAgent;
use Mojo::URL;
use Mojo::File qw(path);
use Mojo::JSON qw(decode_json);
use Mojo::Template;
use Mojo::Util qw(url_escape);
use POSIX qw(strftime);
use Storable qw(retrieve nstore);
use MIME::Base64 qw(encode_base64);
use Encode qw(encode_utf8);
use Getopt::Long 2.25 qw(:config posix_default no_ignore_case);
use Pod::Usage 1.14;

our $VERSION = '2.0.0'; # VERSION

my $ROOT = path($FindBin::RealBin)->dirname;

# fields that are shown and compared, in display order
my @FIELDS = qw(start end recur name loc org);

# texts of the report, selected by the 'language' config key
my %I18N = (
    en => {
        start => 'Start', end => 'End', recur => 'Recurring', name => 'Title',
        loc => 'Location', org => 'Organizer',
        new => 'NEW', changed => 'CHANGED', deleted => 'DELETED',
        n_new => '%d new', n_changed => '%d changed', n_deleted => '%d deleted',
        n_error => '%d errors',
        title => 'Calendar changes', no_changes => 'No changes',
        error => 'Error', first_run_1 => 'First run: %d appointment stored.',
        first_run_n => 'First run: %d appointments stored.',
        details => 'Details (description, attendees, ...) changed',
        generated => 'Generated by zimdiff %s', all_day => 'all day',
        untitled => '(no title)', yes => 'yes', series => 'Recurring appointment',
        wday => [qw(Sun Mon Tue Wed Thu Fri Sat)], date => '%Y-%m-%d',
    },
    de => {
        start => 'Beginn', end => 'Ende', recur => 'Serie', name => 'Titel',
        loc => 'Ort', org => 'Organisator',
        new => 'NEU', changed => 'GEÄNDERT', deleted => 'GELÖSCHT',
        n_new => '%d neu', n_changed => '%d geändert', n_deleted => '%d gelöscht',
        n_error => '%d Fehler',
        title => 'Kalender-Änderungen', no_changes => 'Keine Änderungen',
        error => 'Fehler', first_run_1 => 'Erster Lauf: %d Termin gespeichert.',
        first_run_n => 'Erster Lauf: %d Termine gespeichert.',
        details => 'Details (Beschreibung, Teilnehmer, ...) geändert',
        generated => 'Erzeugt von zimdiff %s', all_day => 'ganztägig',
        untitled => '(ohne Titel)', yes => 'ja', series => 'Serientermin',
        wday => [qw(So Mo Di Mi Do Fr Sa)], date => '%d.%m.%Y',
    },
);
our $LANG = $I18N{en};

sub t ($key, @args) {
    my $text = $LANG->{$key} // $key;
    return @args ? sprintf($text, @args) : $text;
}

my %opt = (config => "$ROOT/etc/zimdiff.conf"); # CONFFILE

binmode STDOUT, ':encoding(UTF-8)';
binmode STDERR, ':encoding(UTF-8)';

sub main {
    GetOptions(\%opt, 'help|h', 'man', 'version', 'noaction|no-action|n',
        'nomail|no-mail|M', 'html=s', 'config|c=s', 'verbose|v', 'login', 'otp=s')
        or exit 1;
    pod2usage(1) if $opt{help};
    pod2usage(-exitstatus => 0, -verbose => 2) if $opt{man};
    if ($opt{version}) { say "zimdiff $VERSION"; exit 0 }

    my $cfg = load_config($opt{config});
    my $lang = $cfg->{language} // 'en';
    $LANG = $I18N{$lang} or die "Unknown language '$lang' (en, de)\n";
    $ENV{TZ} = $cfg->{timezone} if $cfg->{timezone};
    POSIX::tzset();

    my $var = path($cfg->{cache_dir} // "$ROOT/var"); # VARDIR
    $var = $ROOT->child($var) unless $var->is_abs;
    $var->make_path;

    my @cals = map { ref $_ ? $_ : { path => $_ } }
        @ARGV ? @ARGV : @{$cfg->{calendars} // []};
    @cals = ({ path => "$cfg->{zimbra}{user}/Calendar" }) unless @cals;

    my $ua = Mojo::UserAgent->new(
        connect_timeout => 20, request_timeout => 120);

    if ($opt{login}) {
        login($ua, $cfg, $var, 1);
        say "Login OK";
        exit 0;
    }

    my @report;
    my $token = eval { login($ua, $cfg, $var) };
    if (my $err = $@) {
        chomp $err;
        @report = map { { calendar => $_->{name} // $_->{path},
            changes => [], error => "Login: $err" } } @cals;
    }
    else {
        push @report, check_calendar($ua, $cfg, $var, $token, $_) for @cals;
    }

    my $changes = 0;
    $changes += $_->{error} ? 1 : scalar @{$_->{changes}} for @report;

    print text_report(\@report);

    # the mail only lists calendars with something to report
    my @mailrep = grep { $_->{error} or $_->{initialized} or @{$_->{changes}} }
        @report;
    my $html = html_report(\@mailrep, $cfg);
    path($opt{html})->spew(encode_utf8($html)) if $opt{html};

    my $mail = $cfg->{mail} // {};
    my $to = ref $mail->{to} ? $mail->{to} : [ $mail->{to} // () ];
    if ($opt{nomail} or $opt{noaction} or not @$to) {
        say "(no mail sent)" if $opt{verbose};
    }
    elsif ($changes or $mail->{always}) {
        send_mail($mail, subject(\@report, $mail), text_report(\@mailrep), $html);
        say "Mail sent to " . join(', ', @$to)
            if $opt{verbose};
    }
    exit(grep({ $_->{error} } @report) ? 2 : 0);
}

sub load_config ($file) {
    die "Config file $file not found (see etc/zimdiff.conf.dist)\n"
        unless -r $file;
    my $mode = (stat $file)[2] & 07777;
    warn "WARNING: $file is readable by others (chmod 600 recommended)\n"
        if $mode & 0044;
    my $cfg = eval { decode_json(path($file)->slurp) }
        or die "Cannot parse $file: $@";
    for my $key (qw(url user password)) {
        die "Missing zimbra.$key in $file\n" unless $cfg->{zimbra}{$key};
    }
    return $cfg;
}

sub base_url ($cfg) {
    my $url = Mojo::URL->new($cfg->{zimbra}{url});
    return $url->path('/')->query('')->fragment(undef);
}

# Log in with the JSON flavour of the SOAP API and return the auth token.
# Accounts with two factor authentication need a trusted token, stored in
# var/zimbra.trusted; with $interactive the OTP is asked for and a new
# trusted token is saved.
sub login ($ua, $cfg, $var, $interactive = 0) {
    my $z       = $cfg->{zimbra};
    my $trusted = $var->child('zimbra.trusted');
    my %req = (
        _jsns    => 'urn:zimbraAccount',
        account  => { by => 'name', _content => $z->{user} },
        password => { _content => $z->{password} },
    );
    if (!$interactive and -r $trusted) {
        $req{trustedToken} = { _content => $trusted->slurp =~ s/\s+//gr };
    }
    my $auth = auth_request($ua, $cfg, \%req);

    if ((content($auth->{twoFactorAuthRequired}) // '') eq 'true') {
        die "two factor code required, run 'zimdiff --login'\n"
            unless $interactive and ($opt{otp} or -t STDIN);
        my $otp = $opt{otp};
        unless ($otp) {
            print STDERR "OTP for $z->{user}: ";
            chomp($otp = <STDIN> // '');
        }
        die "no OTP given\n" unless $otp =~ /\S/;
        delete $req{trustedToken};
        $auth = auth_request($ua, $cfg, { %req,
            twoFactorCode => { _content => $otp }, deviceTrusted => 1 });
        my $new = content($auth->{trustedToken})
            or die "Zimbra did not return a trusted token\n";
        my $tmp = $var->child('zimbra.trusted.tmp');
        $tmp->spew($new)->chmod(0600)->move_to($trusted);
    }
    my $token = content($auth->{authToken});
    die "Zimbra did not return an auth token\n" unless $token;
    return $token;
}

sub auth_request ($ua, $cfg, $req) {
    my $tx = $ua->post(base_url($cfg)->path('/service/soap/') => json => {
        Header => { context => { _jsns => 'urn:zimbra', nosession => {} } },
        Body   => { AuthRequest => $req },
    });
    my $res  = $tx->res;
    my $json = $res->json // {};
    if (my $fault = $json->{Body}{Fault}) {
        die(($fault->{Reason}{Text} // 'unknown fault') . "\n");
    }
    if (my $err = $tx->error) {
        die(($err->{code} ? "HTTP $err->{code} " : '') . "$err->{message}\n");
    }
    return $json->{Body}{AuthResponse}
        // die "no AuthResponse from Zimbra\n";
}

# SOAP values come as plain value, as { _content => ... } or as a list
sub content ($v) {
    $v = $v->[0] if ref $v eq 'ARRAY';
    $v = $v->{_content} if ref $v eq 'HASH';
    return $v;
}

sub fetch ($ua, $cfg, $token, $cal, %query) {
    my $url = base_url($cfg);
    push @{$url->path->parts}, 'home', split m{/}, $cal;
    $url->query(fmt => 'json', %query);
    my $tx  = $ua->get($url => { Cookie => "ZM_AUTH_TOKEN=$token" });
    if (my $err = $tx->error) {
        die(($err->{code} ? "HTTP $err->{code} " : '') . "$err->{message}\n");
    }
    my $json = $tx->res->json;
    die "Unexpected answer from Zimbra (no JSON)\n"
        unless ref $json eq 'HASH';
    return $json->{appt} // [];
}

sub check_calendar ($ua, $cfg, $var, $token, $c) {
    my $cal   = $c->{path};
    my $res   = { calendar => $c->{name} // $cal, changes => [] };
    my $store = $var->child(url_escape($cal, '^A-Za-z0-9\-_.') . '.store');
    my $now   = time * 1000;

    my $old   = -r $store ? retrieve("$store") : undef;
    my $mtime = $old ? (stat $store)[9] * 1000 : undef;

    my ($current, $past) = eval {
        my $cur  = fetch($ua, $cfg, $token, $cal, start => $now);
        # appointments that moved into the past since the last run are
        # not deletions, so fetch them as well for the comparison
        my $past = $mtime ? fetch($ua, $cfg, $token, $cal, start => $mtime, end => $now) : [];
        ($cur, $past);
    };
    if (my $err = $@) {
        chomp $err;
        $res->{error} = $err;
        return $res;
    }

    my $new = { map { $_->{id} => entry($_) } @$current };
    $res->{count} = scalar keys %$new;

    unless ($opt{noaction}) {
        my $tmp = "$store.tmp";
        nstore($new, $tmp);
        rename $tmp, "$store" or die "rename $tmp: $!\n";
    }

    unless ($old) {
        $res->{initialized} = 1;
        return $res;
    }

    my $cmp = { %$new, map { $_->{id} => entry($_) } @$past };
    my @ch;
    for my $id (keys %$cmp) {
        my ($n, $o) = ($cmp->{$id}, $old->{$id});
        if (not $o) {
            push @ch, { type => 'new', entry => $n };
        }
        elsif ($o->{rev} ne $n->{rev}) {
            my @diff = grep { ($o->{$_} // '') ne ($n->{$_} // '') }
                @FIELDS;
            push @ch, { type => 'changed', entry => $n, old => $o,
                diff => { map { $_ => 1 } @diff } };
        }
    }
    for my $id (keys %$old) {
        push @ch, { type => 'deleted', entry => $old->{$id} }
            unless $cmp->{$id};
    }
    $res->{changes} = [ sort {
        $a->{entry}{sort} cmp $b->{entry}{sort}
            or $a->{entry}{name} cmp $b->{entry}{name}
    } @ch ];
    return $res;
}

sub entry ($appt) {
    my $det = $appt->{inv}[0]{comp}[0] // {};
    my ($s, $e) = ($det->{s}[0], $det->{e}[0]);
    my $org = $det->{or};
    my ($start, $end) = (tmfmt($s) // '?', tmfmt($e) // '');
    if ($det->{allDay} or ($s && !$s->{u} && ($s->{d} // '') =~ /^\d{8}$/)) {
        $end = '' if $end eq $start;
        $end .= ' (' . t('all_day') . ')' if $end;
        $start .= ' (' . t('all_day') . ')' unless $end;
    }
    return {
        id      => $appt->{id},
        rev     => $appt->{rev} // '',
        sort    => sortkey($s),
        start   => $start,
        end     => $end,
        recur   => $det->{recur} ? t('yes') : '',
        name    => $det->{name} // t('untitled'),
        loc     => $det->{loc} // '',
        org     => $org ? ($org->{d} // $org->{a} // '') : '',
        changed => tmfmt({ u => $appt->{d} }) // '',
    };
}

sub sortkey ($t) {
    return '' unless $t;
    my $ms = $t->{u};
    if (!$ms and ($t->{d} // '') =~ /^(\d{4})(\d\d)(\d\d)(?:T(\d\d)(\d\d))?/) {
        $ms = POSIX::mktime(0, $5 // 0, $4 // 0, $3, $2 - 1, $1 - 1900) * 1000;
    }
    return sprintf '%015d', $ms // 0;
}

sub tmfmt ($t) {
    return undef unless $t;
    if ($t->{u}) {
        my @lt = localtime $t->{u} / 1000;
        return t('wday')->[$lt[6]] . strftime(' ' . t('date') . ' %H:%M', @lt);
    }
    my $d = $t->{d} // return undef;
    if ($d =~ /^(\d{4})(\d\d)(\d\d)(?:T(\d\d)(\d\d))?/) {
        my $date = strftime(t('date'), 0, 0, 12, $3, $2 - 1, $1 - 1900);
        return defined $4 ? "$date $4:$5" : $date;
    }
    return $d;
}

sub text_report ($report) {
    return "\n" . t('no_changes') . "\n\n" unless @$report;
    my $out = '';
    for my $r (@$report) {
        $out .= "\n" . uc($r->{calendar}) . "\n" . ('-' x 60) . "\n";
        if ($r->{error}) { $out .= uc(t('error')) . ": $r->{error}\n"; next }
        if ($r->{initialized}) {
            $out .= first_run($r->{count}) . "\n"; next;
        }
        $out .= t('no_changes') . "\n" unless @{$r->{changes}};
        for my $c (@{$r->{changes}}) {
            my $e = $c->{entry};
            $out .= sprintf "%-9s %s  %s%s\n", t($c->{type}),
                $e->{start} . ($e->{end} ? " - $e->{end}" : ''), $e->{name},
                $e->{loc} ? " [$e->{loc}]" : '';
            next unless $c->{type} eq 'changed';
            for my $f (grep { $c->{diff}{$_} } @FIELDS) {
                $out .= sprintf "          %s: %s -> %s\n", t($f),
                    $c->{old}{$f} || '-', $e->{$f} || '-';
            }
        }
    }
    return "$out\n";
}

sub first_run ($count) {
    return t($count == 1 ? 'first_run_1' : 'first_run_n', $count);
}

sub counts ($report) {
    my %n = (new => 0, changed => 0, deleted => 0, error => 0);
    for my $r (@$report) {
        $n{error}++ if $r->{error};
        $n{$_->{type}}++ for @{$r->{changes}};
    }
    return \%n;
}

sub subject ($report, $mail) {
    my $n = counts($report);
    my @p = map { t("n_$_", $n->{$_}) }
        grep { $n->{$_} } qw(new changed deleted error);
    my $prefix = $mail->{subject} // t('title');
    return $prefix . ': ' . (@p ? join(', ', @p) : lc t('no_changes'));
}

