% if ($n->{error}) {
    <span style="display:inline-block;margin:0 6px 4px 0;padding:3px 10px;border-radius:12px;background:#c5221f;color:#fff;font-weight:600;"><%= $t->('n_error', $n->{error}) %></span>
% }
  </div>
</td></tr>
% unless (@$report) {
