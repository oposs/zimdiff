  <div style="margin-top:10px;padding:10px 12px;background:#fdecea;color:#c5221f;border-radius:6px;font-size:14px;"><%= $t->('error') %>: <%= $r->{error} %></div>
% } elsif ($r->{initialized}) {
  <div style="margin-top:10px;font-size:14px;color:#5f6368;"><%= main::first_run($r->{count}) %></div>
% } elsif (!@{$r->{changes}}) {
  <div style="margin-top:10px;font-size:14px;color:#5f6368;"><%= $t->('no_changes') %></div>
% } else {
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:10px;border-collapse:collapse;font-size:14px;">
%   for my $c (@{$r->{changes}}) {
%     my $e = $c->{entry};
%     my $del = $c->{type} eq 'deleted' ? 'text-decoration:line-through;color:#80868b;' : '';
    <tr>
      <td valign="top" style="padding:10px 10px 10px 0;border-top:1px solid #eceff1;width:84px;">
        <span style="display:inline-block;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:700;background:<%= $col{$c->{type}}[0] %>;color:<%= $col{$c->{type}}[1] %>;"><%= $t->($c->{type}) %></span>
      </td>
      <td valign="top" style="padding:10px 0;border-top:1px solid #eceff1;">
        <div style="font-weight:600;<%= $del %>"><%= $e->{name} %><% if ($e->{recur}) { %> <span style="font-weight:400;color:#5f6368;" title="<%= $t->('series') %>">&#x21bb;</span><% } %></div>
        <div style="color:#3c4043;margin-top:2px;<%= $del %>"><%= $e->{start} %><% if ($e->{end}) { %> &ndash; <%= $e->{end} %><% } %></div>
